# Ginga 0.3.1 - ambiente local/LAN
# Copie para .env ou rode ./scripts/init.sh para gerar os segredos automaticamente.

# PostgreSQL
POSTGRES_DB=ginga
POSTGRES_USER=ginga
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# API e autenticação
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_48_CHARACTERS
JWT_EXPIRES_IN=12h
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
PWNED_PASSWORD_CHECK=true
APP_ORIGINS=http://localhost,http://127.0.0.1
GINGA_SERVER_URL=http://localhost
PASSWORD_RESET_BASE_URL=http://localhost
MAX_UPLOAD_MB=50
MAX_USER_STORAGE_MB=2048
ALLOW_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=false
PLATFORM_OWNER_USERNAME=
ALLOW_FIRST_USER_PLATFORM_OWNER=false

# LiveKit / WebRTC
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Versão
GINGA_RELEASE_VERSION=0.3.1

# E-mail (opcional se EMAIL_VERIFICATION_REQUIRED=false)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Ginga <no-reply@example.com>"

# Integrações opcionais
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MUSIC_MAX_QUEUE=200
MUSIC_MAX_PLAYLIST_ITEMS=50

# Exibido na landing e na Base de Conhecimento
GITHUB_REPOSITORY_URL=
