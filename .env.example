# Ginga - exemplo de configuracao
# Copie para .env ou rode ./scripts/init.sh para gerar segredos fortes automaticamente.

NODE_ENV=production

# Banco/Redis
POSTGRES_DB=ginga
POSTGRES_USER=ginga
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_INIT

# API / autenticacao
JWT_SECRET=CHANGE_ME_GENERATED_BY_INIT_CHANGE_ME_GENERATED_BY_INIT_1234567890
JWT_EXPIRES_IN=12h
MFA_ENCRYPTION_KEY=CHANGE_ME
JWT_ISSUER=ginga-api
JWT_AUDIENCE=ginga-client
APP_ORIGINS=http://localhost:3090
ALLOW_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=false
ALLOW_FIRST_USER_PLATFORM_OWNER=true
ALLOW_LEGACY_WEBHOOK_URL_TOKENS=false
PLATFORM_OWNER_USERNAME=
PASSWORD_RESET_BASE_URL=http://localhost:3090
PWNED_PASSWORD_CHECK=true

# Uploads / limites
MAX_UPLOAD_MB=50
MAX_USER_STORAGE_MB=2048

# LiveKit
LIVEKIT_API_KEY=CHANGE_ME_GENERATED_BY_INIT
LIVEKIT_API_SECRET=CHANGE_ME_GENERATED_BY_INIT
PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_SIGNAL_BIND=127.0.0.1
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_LOG_LEVEL=warn

# Web / reverse proxy
WEB_BIND=127.0.0.1
WEB_PORT=3090
APP_DOMAIN=localhost
LIVEKIT_DOMAIN=localhost
GITHUB_REPOSITORY_URL=

# E-mail (necessario se EMAIL_VERIFICATION_REQUIRED=true)
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Musica (opcional)
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MUSIC_MAX_QUEUE=200
MUSIC_MAX_PLAYLIST_ITEMS=50
