# Ginga 0.4.5 - exemplo seguro para GitHub
# Rode ./scripts/init.sh para criar .env e substituir os principais segredos.

# Banco de dados
POSTGRES_DB=ginga
POSTGRES_USER=ginga
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# API / autenticacao
JWT_SECRET=CHANGE_ME_JWT_SECRET_WITH_AT_LEAST_48_CHARACTERS_0000
JWT_EXPIRES_IN=12h
JWT_ISSUER=ginga-api
JWT_AUDIENCE=ginga-client
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
PWNED_PASSWORD_CHECK=true
ALLOW_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=false
ALLOW_FIRST_USER_PLATFORM_OWNER=false
ALLOW_LEGACY_WEBHOOK_URL_TOKENS=false
PLATFORM_OWNER_USERNAME=

# URLs da instalacao
APP_ORIGINS=http://127.0.0.1:3090,http://localhost:3090
GINGA_SERVER_URL=http://127.0.0.1:3090
PASSWORD_RESET_BASE_URL=http://127.0.0.1:3090
APP_DOMAIN=ginga.example.com
LIVEKIT_DOMAIN=media.ginga.example.com
GITHUB_REPOSITORY_URL=https://github.com/GabrielBosco/ginga

# Uploads / limites
MAX_UPLOAD_MB=50
MAX_USER_STORAGE_MB=2048

# LiveKit / WebRTC
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
LIVEKIT_INTERNAL_URL=http://livekit:7880
PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_LOG_LEVEL=warn

# Bind / portas
WEB_BIND=127.0.0.1
WEB_PORT=3090
LIVEKIT_SIGNAL_BIND=127.0.0.1
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Protecoes / rate limits opcionais
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCK_MINUTES=15
AUTH_LOGIN_LIMIT_10M=20
AUTH_REGISTER_LIMIT_HOUR=10
API_RATE_LIMIT_5M=1200
UPLOAD_RATE_LIMIT_HOUR=120
SOCKET_MESSAGE_LIMIT_10S=40
SOCKET_CALL_LIMIT_MINUTE=10
LIVEKIT_TOKEN_LIMIT_MINUTE=60

# Versao / noticias de release
GINGA_RELEASE_VERSION=0.4.5
AUTO_PUBLISH_RELEASE_NEWS=true
GINGA_RELEASE_NOTES=

# E-mail - configure somente se for usar verificacao/reset
EMAIL_PROVIDER=smtp
EMAIL_FROM="Ginga <noreply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Ginga Music - opcional
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MUSIC_MAX_QUEUE=200
MUSIC_MAX_PLAYLIST_ITEMS=50
