# Ginga 0.2.0 - exemplo para Internet/HTTPS
# Copie para .env e substitua example.com antes de subir a stack.

POSTGRES_DB=ginga
POSTGRES_USER=ginga
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_48_CHARACTERS
JWT_EXPIRES_IN=12h
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
PWNED_PASSWORD_CHECK=true

APP_DOMAIN=chat.example.com
LIVEKIT_DOMAIN=media.example.com
APP_ORIGINS=https://chat.example.com
GINGA_SERVER_URL=https://chat.example.com
PASSWORD_RESET_BASE_URL=https://chat.example.com
PUBLIC_LIVEKIT_URL=wss://media.example.com

MAX_UPLOAD_MB=50
MAX_USER_STORAGE_MB=2048
ALLOW_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=true
PLATFORM_OWNER_USERNAME=
ALLOW_FIRST_USER_PLATFORM_OWNER=false

LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

GINGA_RELEASE_VERSION=0.2.0

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Ginga <no-reply@example.com>"

YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MUSIC_MAX_QUEUE=200
MUSIC_MAX_PLAYLIST_ITEMS=50
GITHUB_REPOSITORY_URL=https://github.com/OWNER/REPOSITORY
